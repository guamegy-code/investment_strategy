{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/strategy-dsl-v1.schema.json",
  "title": "Investment strategy DSL v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy"],
  "oneOf": [
    {"required": ["assets", "target"]},
    {"required": ["source", "products"]}
  ],
  "properties": {
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "integer"]},
        "dsl_version": {"type": ["string", "integer"]},
        "enabled": {"type": "boolean"}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "risk": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}
      }
    },
    "parameters": {"type": "object"},
    "variables": {"type": "object"},
    "state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["initial"],
        "properties": {
          "initial": {},
          "check": {"enum": ["daily", "weekly", "monthly", "quarterly"]},
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["set"],
              "properties": {
                "when": {"type": "string"},
                "otherwise": {"const": true},
                "set": {},
                "confirm": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["weights"],
        "properties": {
          "when": {"type": "string"},
          "weights": {"type": "object", "minProperties": 1}
        }
      }
    },
    "rebalance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when"],
        "properties": {
          "when": {"type": "string"},
          "check": {"enum": ["daily", "weekly", "monthly", "quarterly"]},
          "days": {"type": ["string", "integer"]}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"days": {"type": ["string", "integer"]}}
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "products": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"type": ["string", "number"]}
      }
    }
  }
}
