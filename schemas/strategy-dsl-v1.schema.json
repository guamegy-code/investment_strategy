{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/strategy-dsl-v1.schema.json",
  "title": "Investment strategy DSL v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy"],
  "oneOf": [
    {"required": ["assets", "target"]},
    {"required": ["source", "products"], "not": {"required": ["notifications"]}}
  ],
  "properties": {
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "integer"]},
        "dsl_version": {"type": ["string", "integer"]},
        "enabled": {"type": "boolean"}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "observations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "risk": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}
      }
    },
    "parameters": {"type": "object"},
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "fx_ticker", "foreign_assets"],
      "properties": {
        "currency": {"const": "KRW"},
        "fx_ticker": {"type": "string", "minLength": 1},
        "signal_currency": {"enum": ["LOCAL", "KRW"]},
        "foreign_assets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "variables": {"type": "object"},
    "state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["initial"],
        "properties": {
          "initial": {},
          "check": {"enum": ["daily", "weekly", "monthly", "quarterly"]},
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["set"],
              "properties": {
                "when": {"type": "string"},
                "otherwise": {"const": true},
                "set": {},
                "confirm": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["weights"],
        "properties": {
          "when": {"type": "string"},
          "weights": {"type": "object", "minProperties": 1}
        }
      }
    },
    "rebalance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when"],
        "properties": {
          "when": {"type": "string"},
          "check": {"enum": ["daily", "weekly", "monthly", "quarterly"]},
          "days": {"type": ["string", "integer"]}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"days": {"type": ["string", "integer"]}}
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weekly": {"type": "boolean"},
        "states": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "alerts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["to"],
                  "properties": {
                    "on": {"enum": ["changed", "confirmation_started"]},
                    "from": {"type": ["string", "number", "boolean"]},
                    "to": {
                      "oneOf": [
                        {"type": ["string", "number", "boolean"]},
                        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": ["string", "number", "boolean"]}}
                      ]
                    },
                    "message": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "max": {"type": "number"},
              "decimals": {"type": "integer", "minimum": 0, "maximum": 6}
            }
          }
        },
        "market": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ticker", "field", "label"],
            "properties": {
              "ticker": {"type": "string", "minLength": 1},
              "field": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "format": {"enum": ["number", "percent", "ratio_percent", "price"]},
              "decimals": {"type": "integer", "minimum": 0, "maximum": 6}
            }
          }
        },
        "prealerts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "when", "reset_when", "message"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "when": {"type": "string", "minLength": 1},
              "reset_when": {"type": "string", "minLength": 1},
              "message": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sleeve", "candidates"],
      "properties": {
        "sleeve": {"type": "string", "minLength": 1},
        "check": {"enum": ["daily", "weekly", "monthly", "quarterly"]},
        "top_n": {"type": "integer", "minimum": 1},
        "max_single_sleeve_share": {"type": ["string", "number"]},
        "max_gold_sleeve_share": {"type": ["string", "number"]},
        "max_equity_sleeve_share": {"type": ["string", "number"]},
        "switch_score_margin": {"type": ["string", "number"]},
        "minimum_hold_periods": {"type": "integer", "minimum": 0},
        "minimum_weight_change": {"type": ["string", "number"]},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ticker", "group", "asset_class"],
            "properties": {
              "ticker": {"type": "string", "minLength": 1},
              "group": {"type": "string", "minLength": 1},
              "asset_class": {"enum": ["BOND", "EQUITY", "GOLD"]}
            }
          }
        }
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "products": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"type": ["string", "number"]}
      }
    }
  }
}
